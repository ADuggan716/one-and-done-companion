# Splash Sports login credentials
# Copy this file to .env and fill in your real values.
# .env is git-ignored and never committed.

SPLASH_EMAIL=your@email.com
SPLASH_PASSWORD=yourpassword

# Optional: path to system Chromium.
# Required on Raspberry Pi (ARM) — Playwright's bundled Chromium is x86-only.
# On the Pi, install with: sudo apt install -y chromium-browser
# Then set this:
# CHROMIUM_PATH=/usr/bin/chromium-browser
